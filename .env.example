# =====================================================================
# Chatterbox AI Voice Studio - Environment Configuration
# =====================================================================

# Deployment mode: "local" (in-process inference) or "remote" (call REST API)
CHATTERBOX_MODE=local

# Remote Server URL (used when CHATTERBOX_MODE=remote or for dashboard connection)
CHATTERBOX_SERVER_URL=http://localhost:8000

# REST API Authentication Key (leave empty for unauthenticated local development)
# For remote VPS/cloud GPU servers, specify a strong secret key
CHATTERBOX_API_KEY=

# Server Bind Host and Port
CHATTERBOX_HOST=0.0.0.0
CHATTERBOX_PORT=8000

# Inference Device: "auto" (detects CUDA, then MPS, then CPU), or "cuda", "mps", "cpu"
CHATTERBOX_DEVICE=auto

# Chatterbox Multilingual Model Checkpoint: "v3" (recommended) or "v2"
CHATTERBOX_T3_MODEL=v3

# Storage directories
CHATTERBOX_STORAGE_DIR=generated_audio
CHATTERBOX_PROFILES_DIR=voice_profiles

# Maximum file upload limit for reference audio in MB (default 25MB)
CHATTERBOX_MAX_UPLOAD_MB=25

# Mock inference mode for unit testing and CI without downloading 2GB+ model weights
CHATTERBOX_MOCK_INFERENCE=false

# Optional Hugging Face Token for faster rate-unlimited model downloads
HF_TOKEN=
